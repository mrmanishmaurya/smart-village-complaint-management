# Smart Village Complaint Management System - Environment Variables Configuration

# Database Configuration (MySQL / SQLite)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=smart_village
DB_PORT=3306
DB_TYPE=mysql
REQUIRE_CENTRAL_DB=false

# Application Security
SECRET_KEY=smart-village-secret-key-2026
ADMIN_EMAIL=admin@smartvillage.com
ADMIN_PASSWORD=your_admin_password

# Google Maps API Key
# Enables Google Maps location picker, address autocomplete, and admin complaint maps
# Required Google APIs: Maps JavaScript API, Geocoding API, Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
